# Copy this file to the repo root as `.env` and fill in real values.
# `docker compose` reads the root .env automatically.

# --- RDS PostgreSQL connection ---
# Format: postgresql+psycopg://<user>:<password>@<rds-endpoint>:5432/<db-name>
# Example:
# DATABASE_URL=postgresql+psycopg://cpp_admin:CHANGE_ME@cpp-qa.abc123.eu-west-1.rds.amazonaws.com:5432/planning
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS_ENDPOINT:5432/planning

# --- CORS ---
# With the nginx same-origin proxy this is not strictly needed, but set it to the
# QA site origin to be safe. Comma-separated list.
CORS_ORIGINS=http://YOUR_QA_HOST

# --- Auth ---
# dev  = trusts the X-User header (no real login) — QA only, keep the site private.
# cognito = JWT verification (not implemented in this build).
AUTH_MODE=dev
