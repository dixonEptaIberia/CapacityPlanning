# Database (default: local SQLite for dev). For production use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/planning
DATABASE_URL=sqlite:///./planning.db

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Auth: dev mode trusts a header-provided identity. In production, verify Cognito JWTs.
AUTH_MODE=dev
